---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CATEGORIES, FREE_DRAW_LABEL } from '../lib/questions'

const steps = [
  { id: 'question', label: '选问题' },
  { id: 'confirm', label: '确认' },
  { id: 'draw', label: '抽牌' },
  { id: 'core', label: '核心解读' },
  { id: 'reflect', label: '反思问答' },
  { id: 'personal', label: '个性化解读' },
  { id: 'finish', label: '收尾' },
]
---

<BaseLayout
  title="抽一张牌 · 塔罗牌"
  description="带着一个已经确认的问题抽一张牌：洗牌、翻牌，然后读画面、象征和结合问题的三层解读。"
  island={true}
>
  <section class="shell max-w-3xl py-8" data-read-app>
    <ol class="flex list-none flex-wrap gap-2 p-0 text-xs" data-progress aria-label="流程进度">
      {
        steps.map((step, index) => (
          <li class="tag" data-step-marker={step.id}>
            <span class="text-[var(--color-gold)]">{index + 1}</span>
            <span class="ml-1">{step.label}</span>
          </li>
        ))
      }
    </ol>

    <p
      data-notice
      class="mt-4 hidden rounded-xl border border-[color-mix(in_oklab,var(--color-gold)_45%,transparent)] bg-[color-mix(in_oklab,var(--color-gold)_10%,transparent)] p-3 text-sm"
      role="status"
    >
    </p>

    <section data-step="question" class="mt-6">
      <h1 class="text-2xl">先选一个最贴近的问题</h1>
      <p class="mt-2 text-sm text-[var(--color-muted)]">
        一级分类有八个，点开后再挑一条具体问法。选不出来也没关系，最后有一个出口。
      </p>

      <div class="mt-6 grid gap-3 sm:grid-cols-2" data-category-list>
        {
          CATEGORIES.map((category) => (
            <button type="button" class="btn justify-start text-left" data-category={category.id}>
              {category.label}
            </button>
          ))
        }
      </div>

      <div class="mt-6 hidden" data-question-panel>
        <button type="button" class="btn btn-quiet" data-action="back-to-categories">
          ← 换一个分类
        </button>
        <div class="mt-3 space-y-5" data-question-list></div>
      </div>

      <div class="panel mt-8">
        <p class="text-sm text-[var(--color-muted)]">
          不知道怎么提问的人，是这里最主要的使用者。直接抽一张牌，看看此刻你需要看见什么。
        </p>
        <button type="button" class="btn btn-primary mt-3" data-free-draw>
          {FREE_DRAW_LABEL}
        </button>
      </div>
    </section>

    <section data-step="confirm" class="mt-6 hidden"></section>
    <section data-step="draw" class="mt-6 hidden"></section>
    <section data-step="core" class="mt-6 hidden"></section>
    <section data-step="reflect" class="mt-6 hidden"></section>
    <section data-step="personal" class="mt-6 hidden"></section>
    <section data-step="finish" class="mt-6 hidden"></section>

    <noscript>
      <p class="panel mt-6 text-sm">
        抽牌流程需要 JavaScript 才能运行。你也可以直接阅读
        <a class="underline decoration-dotted" href="/cards">78 张牌义</a>，那里的内容不需要脚本。
      </p>
    </noscript>
  </section>

  <script>
    import '../scripts/read-app'
  </script>
</BaseLayout>
